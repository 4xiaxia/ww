# Gemini API Configuration
# Get your API key from https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# API Base URL (optional, for custom endpoints)
API_BASE_URL=

# API Key (optional, alternative to GEMINI_API_KEY)
API_KEY=

# Repository name for GitHub Pages deployment (optional)
# Set this to your repository name if deploying to GitHub Pages
# Example: REPO_NAME=ww
# If not set, defaults to root path '/'
REPO_NAME=
