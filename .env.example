# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 胜算云专线 API 配置 (Shengsuanyun Dedicated Line Configuration)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 【必填】您的 Gemini API 密钥
# Required: Your Gemini API Key
# 获取地址 / Get your API key from: https://aistudio.google.com/app/apikey
# 
# 支持多个密钥负载均衡（用英文逗号分隔）
# You can specify multiple keys separated by commas for load balancing
# Example: API_KEY=key1,key2,key3
API_KEY=your_api_key_here

# 【推荐】胜算云专线地址（默认已配置）
# Recommended: Shengsuanyun Dedicated Line (Pre-configured)
# 
# 本应用默认使用胜算云API代理，确保国内访问稳定性
# This app uses Shengsuanyun API proxy by default for stable access in Mainland China
# 
# 专线优势：
# ✅ 国内访问稳定可靠
# ✅ 低延迟高速响应
# ✅ 无需额外配置
#
# 如需使用其他端点，请修改下方地址
# To use a different endpoint, modify the URL below
API_BASE_URL=https://router.shengsuanyun.com/api

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 验证步骤 (Verification Steps)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 
# 1. 复制此文件为 .env.local:
#    cp .env.example .env.local
#
# 2. 填入您的 API_KEY
#
# 3. 运行开发服务器:
#    npm run dev
#
# 4. 查看控制台输出，确认看到以下信息：
#    ✅ [Config] Using Shengsuanyun dedicated line (胜算云专线)
#    ✅ [API Test] Successfully connected to Shengsuanyun API
#    ✅ [CNService] Connected to Shengsuanyun (胜算云专线)
#
# 5. 界面右上角显示 "✅ 胜算云专线已连接"
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
